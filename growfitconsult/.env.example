# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered (Fernando's inbox)
CONTACT_TO_EMAIL=

# Optional. Sender shown on the notification email. Must be on a domain you
# have verified in Resend. If empty, Resend's shared test sender is used,
# which can only deliver to the email address of your Resend account.
CONTACT_FROM_EMAIL=

# Optional. The site's public URL, used for canonical links, the sitemap and
# Open Graph tags. On Vercel this falls back to the production URL automatically.
NEXT_PUBLIC_SITE_URL=
