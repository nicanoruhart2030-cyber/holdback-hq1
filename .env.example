# --- App ---
# Public base URL (used for links). Set to your Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by the daily cron and client deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Groq (extraction + drafting) ---
GROQ_API_KEY=
# Default model. Any Groq chat model that supports JSON mode works.
GROQ_MODEL=llama-3.3-70b-versatile
# AI features are DISABLED unless this is "developer" or "enterprise" (paid tiers).
# Client documents are never sent to free-tier models.
GROQ_ACCOUNT_TIER=

# --- Google Cloud Vision (optional OCR for scanned PDFs and images) ---
# Leave empty to skip OCR; scanned documents then need manual entry.
GOOGLE_VISION_API_KEY=

# --- Resend (outbound email, only after manual approval) ---
RESEND_API_KEY=
# Must be a verified sender domain in Resend, e.g. "Holdback HQ <billing@youragency.ca>"
RESEND_FROM_EMAIL=

# --- Vercel Cron ---
# Long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
